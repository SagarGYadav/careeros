# CareerOS environment variables. Copy to .env and fill in. Never commit .env.
# Full reference: docs/SPEC.md §26.

# --- Database -------------------------------------------------------------------------------------------------
# Neon: project "careeros" -> Connect -> connection pooling OFF. Main branch here, "test" branch below.
DATABASE_URL=
DATABASE_URL_TEST=
# Docker alternative (docker compose up -d):
# DATABASE_URL=postgresql://careeros:careeros@localhost:5432/careeros
# DATABASE_URL_TEST=postgresql://careeros:careeros@localhost:5432/careeros_test

# --- Auth -----------------------------------------------------------------------------------------------------
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Set to false after creating your own account on a deployed instance.
ALLOW_SIGNUP=true
ENABLE_DEMO_LOGIN=true

# --- External services: each *_PROVIDERS list is a chain, main first then backups (SPEC §7.2) -----------------
# Keep "mock" until you add free keys. Providers without keys are skipped.
AI_PROVIDERS=mock
# Real use: AI_PROVIDERS=gemini,gemini-lite,groq,openrouter (free keys: aistudio.google.com, console.groq.com, openrouter.ai)
# gemini-lite uses the same GEMINI_API_KEY with Flash-Lite, which has its own (larger) free quota.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides (defaults: Gemini "-latest" Flash aliases, Groq gpt-oss-120b / gpt-oss-20b)
# GEMINI_MODEL_FAST= GEMINI_MODEL_BALANCED= GEMINI_MODEL_STRONG= GROQ_MODEL_FAST= GROQ_MODEL_BALANCED=
# OPENROUTER_FREE_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
JOB_SEARCH_PROVIDERS=mock
WEB_SEARCH_PROVIDERS=mock
EMBEDDING_PROVIDERS=mock
DEEP_SEARCH_ENABLED=false

# --- Storage --------------------------------------------------------------------------------------------------
STORAGE_PROVIDER=database

# --- Tests ----------------------------------------------------------------------------------------------------
# Dev/test account used by e2e tests and manual checks (local only).
E2E_USER_EMAIL=e2e-user@careeros.test
E2E_USER_PASSWORD=

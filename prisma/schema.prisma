// CareerOS database schema. Models are added phase by phase (see docs/ROADMAP.md).
// The connection URL lives in prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------------------------
// Auth (Better Auth). Field names must match what Better Auth expects (see `getAuthTables` in better-auth/db);
// only the table names are mapped. Models used by CareerOS itself are added in later phases.
// ---------------------------------------------------------------------------------------------------------------

model User {
  id              String               @id
  name            String
  email           String               @unique
  emailVerified   Boolean              @default(false)
  image           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  sessions        Session[]
  accounts        Account[]
  aiResults       AiResultCache[]
  aiRequests      AiRequestLog[]
  personal        PersonalDetails?
  profile         CareerProfile?
  skills          UserSkill[]
  experiences     ExperienceEntry[]
  projects        ProjectEntry[]
  educations      EducationEntry[]
  certifications  CertificationEntry[]
  otherSections   OtherCvSection[]
  facts           CareerFact[]
  resumes         ResumeVersion[]
  files           StoredFile[]
  targetRoles     TargetRole[]
  companies       Company[]
  jobs            Job[]
  searchRuns      JobSearchRun[]
  jobRequirements JobRequirement[]
  scoringConfigs  ScoringConfig[]
  jobAnalyses     JobAnalysis[]
  careerSites     CareerSite[]
  applications    Application[]
  appEvents       ApplicationEvent[]
  interviewRounds InterviewRound[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Database-backed rate limiting for auth endpoints (shared across serverless instances).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt // epoch milliseconds

  @@map("rate_limits")
}

// ---------------------------------------------------------------------------------------------------------------
// External services (SPEC §7.2–7.3). Quotas belong to the app's API keys, so usage and health are app-wide,
// not per user.
// ---------------------------------------------------------------------------------------------------------------

/// Request counters per provider and period, used to stop before a free quota runs out.
model ProviderUsage {
  id          String   @id @default(cuid())
  service     String // ai | job_search | web_search | embeddings
  provider    String
  periodKind  String // minute | day | month
  periodStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([service, provider, periodKind, periodStart])
  @@map("provider_usage")
}

/// Live health of each provider: cooldowns after 429s, quota exhaustion and the circuit breaker.
model ProviderHealth {
  service             String
  provider            String
  cooldownUntil       DateTime?
  exhaustedUntil      DateTime?
  reportedRemaining   Int?
  consecutiveFailures Int       @default(0)
  circuitOpenUntil    DateTime?
  lastErrorKind       String?
  lastFailureAt       DateTime?
  lastSuccessAt       DateTime?
  updatedAt           DateTime  @updatedAt

  @@id([service, provider])
  @@map("provider_health")
}

/// Order and on/off overrides set in Settings → Services (defaults come from the *_PROVIDERS env lists).
model ProviderSetting {
  service   String   @id
  order     String[]
  disabled  String[]
  updatedAt DateTime @updatedAt

  @@map("provider_settings")
}

/// One row per AI call attempt. Never stores prompt or output content (SPEC §8.5).
model AiRequestLog {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  workflow       String
  promptVersion  String
  provider       String
  model          String
  status         String // ok | repaired | invalid_output | error
  errorKind      String?
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int
  fallbackFrom   String?
  fallbackReason String?
  inputHash      String
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([provider, createdAt])
  @@map("ai_request_logs")
}

/// Validated AI outputs keyed by a hash of the exact input, so identical requests never call the AI twice.
model AiResultCache {
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow      String
  inputHash     String
  promptVersion String
  output        Json
  provider      String
  model         String
  createdAt     DateTime @default(now())

  @@id([userId, workflow, inputHash])
  @@map("ai_result_cache")
}

// ---------------------------------------------------------------------------------------------------------------
// Career profile and CV (SPEC §4, §9). Dates on CV entries are "YYYY-MM" strings: CVs often give only a year or
// a month, and durations are computed in code from these.
// ---------------------------------------------------------------------------------------------------------------

/// Contact and personal details. Sensitive: never used for matching, never sent to search providers, never logged.
model PersonalDetails {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String?
  email        String?
  phone        String?
  city         String?
  state        String?
  country      String?
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?
  otherLinks   String[]
  /// Only what the CV itself contains, e.g. date of birth or languages known.
  otherDetails Json?
  updatedAt    DateTime @updatedAt

  @@map("personal_details")
}

model CareerProfile {
  userId                String                      @id
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline              String?
  summary               String?
  /// Computed from experience dates (overlaps merged), not taken from the AI.
  yearsExperience       Float?
  /// Annual amounts in `currency`. INR is shown as LPA.
  currentCtc            Int?
  expectedCtcMin        Int?
  expectedCtcMax        Int?
  currency              String                      @default("INR")
  noticePeriodDays      Int?
  preferredLocations    String[]
  /// remote | hybrid | onsite
  workModes             String[]
  openToRelocate        Boolean                     @default(false)
  /// { bond, nightShift, contractToHire, maxWfoDaysPerWeek }: conditions the user never accepts.
  dealbreakers          Json?
  domains               String[]
  onboardingCompletedAt DateTime?
  /// When the user last opened the "For you" feed; newer jobs get a "New" badge.
  feedSeenAt            DateTime?
  /// CV profile vector for semantic matching (SPEC §10.5): summary + bullets + skills, bge-small-en-v1.5.
  embedding             Unsupported("vector(384)")?
  /// The model that made `embedding`; vectors are only compared with vectors of the same model.
  embeddingModel        String?
  embeddingSourceHash   String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@map("career_profiles")
}

/// Role catalogue used to suggest and categorise target roles (seeded, editable).
model RoleFamily {
  id             String            @id @default(cuid())
  slug           String            @unique
  name           String
  description    String?
  titleVariants  String[]
  /// [{ level, minYears, maxYears }]
  seniorityBands Json
  adjacentSlugs  String[]
  coreSkills     RoleFamilySkill[]
  targetRoles    TargetRole[]

  @@map("role_families")
}

model RoleFamilySkill {
  roleFamilyId String
  roleFamily   RoleFamily @relation(fields: [roleFamilyId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([roleFamilyId, skillId])
  @@map("role_family_skills")
}

/// Skill taxonomy. ownerKey is "global" for the seeded catalogue, or a user id for skills a user added.
model Skill {
  id              String            @id @default(cuid())
  ownerKey        String            @default("global")
  slug            String
  name            String
  /// language | framework | library | styling | mobile | backend | database | testing | tooling | cloud | practice | data | soft
  category        String
  aliases         String[]
  /// 1 small, 2 medium, 3 large (rough effort to learn)
  learningEffort  Int               @default(2)
  /// Curated free resources: [{ title, url }]. The AI never generates these links.
  resources       Json?
  /// A user-added skill not yet reviewed against the catalogue.
  unreviewed      Boolean           @default(false)
  roleFamilies    RoleFamilySkill[]
  relationsFrom   SkillRelation[]   @relation("from")
  relationsTo     SkillRelation[]   @relation("to")
  userSkills      UserSkill[]
  jobRequirements JobRequirement[]

  @@unique([ownerKey, slug])
  @@map("skills")
}

/// "implies": knowing `from` means knowing `to` (Next.js implies React). "related": partial credit (Redux ~ Zustand).
model SkillRelation {
  fromSkillId String
  from        Skill  @relation("from", fields: [fromSkillId], references: [id], onDelete: Cascade)
  toSkillId   String
  to          Skill  @relation("to", fields: [toSkillId], references: [id], onDelete: Cascade)
  type        String

  @@id([fromSkillId, toSkillId])
  @@map("skill_relations")
}

model UserSkill {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId           String
  skill             Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  /// 1 to 5
  proficiency       Int
  /// user | rule | ai_suggested
  proficiencySource String
  proficiencyReason String?
  years             Float?
  lastUsedYear      Int?
  /// CV evidence ids (E-ids) where the skill appears.
  evidenceIds       String[]
  /// cv_section | cv_inferred | self | import
  source            String
  confirmed         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, skillId])
  @@map("user_skills")
}

model UserSkillHistory {
  id          String   @id @default(cuid())
  userId      String
  skillId     String
  proficiency Int
  changedAt   DateTime @default(now())

  @@index([userId, skillId, changedAt])
  @@map("user_skill_history")
}

model ExperienceEntry {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        String
  title          String
  employmentType String?
  location       String?
  workMode       String?
  startDate      String?
  endDate        String?
  isCurrent      Boolean  @default(false)
  durationMonths Int?
  domain         String?
  teamSize       String?
  summary        String?
  /// [{ id: "E3", text, kind: "responsibility" | "achievement", hasMetric }]
  bullets        Json
  technologies   String[]
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, sortOrder])
  @@map("experience_entries")
}

model ProjectEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  role         String?
  description  String?
  technologies String[]
  links        String[]
  startDate    String?
  endDate      String?
  /// [{ id: "E9", text }]
  bullets      Json
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, sortOrder])
  @@map("project_entries")
}

model EducationEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution String
  degree      String?
  field       String?
  startDate   String?
  endDate     String?
  /// As written, e.g. "8.4 CGPA" or "78%".
  grade       String?
  location    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, sortOrder])
  @@map("education_entries")
}

model CertificationEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  issuer       String?
  issueDate    String?
  expiryDate   String?
  credentialId String?
  url          String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, sortOrder])
  @@map("certification_entries")
}

/// Awards, publications, volunteering, spoken languages, interests and anything else: nothing in the CV is dropped.
model OtherCvSection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String?
  items     Json
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sortOrder])
  @@map("other_cv_sections")
}

/// Career memory (SPEC §20). The AI may only add `pending` facts; only `active` facts are ever sent to the AI.
model CareerFact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  /// preference | strength | goal | constraint | learning
  category  String
  /// user | ai_suggested | import
  source    String
  /// active | pending | archived
  status    String
  evidence  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("career_facts")
}

/// Uploaded files, stored in Postgres (STORAGE_PROVIDER=database): free, and fine for a few small CVs.
model StoredFile {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  sha256    String
  bytes     Bytes
  createdAt DateTime        @default(now())
  resumes   ResumeVersion[]

  @@index([userId, sha256])
  @@map("stored_files")
}

model ResumeVersion {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  targetRoleFamilyId String?
  parentId           String?
  parent             ResumeVersion?  @relation("lineage", fields: [parentId], references: [id], onDelete: SetNull)
  children           ResumeVersion[] @relation("lineage")
  isDefault          Boolean         @default(false)
  fileId             String?
  file               StoredFile?     @relation(fields: [fileId], references: [id], onDelete: SetNull)
  extractedText      String?
  pageCount          Int?
  /// Hyperlinks found in the file: [{ text, url, page }]
  links              Json?
  /// ParsedCv (SPEC §9.2) as confirmed or edited by the user.
  parsed             Json?
  /// CV evidence catalog: [{ id: "E1", text, section, location }]
  evidence           Json?
  /// Verification report: grounding, completeness, deterministic overrides (SPEC §9.1).
  verification       Json?
  /// uploaded | parsed | confirmed | failed
  parseStatus        String          @default("uploaded")
  /// ai | cache | no_ai
  parseMode          String?
  parseProvider      String?
  injectionSuspected Boolean         @default(false)
  confirmedAt        DateTime?
  analyses           JobAnalysis[]
  applications       Application[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId, createdAt])
  @@map("resume_versions")
}

/// A role the user wants to find jobs for (SPEC §4, §10.1). Category (core / adjacent / stretch) and seniority are
/// computed in code from the user's skills and years when shown, so they follow profile edits.
model TargetRole {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleFamilyId   String?
  roleFamily     RoleFamily? @relation(fields: [roleFamilyId], references: [id], onDelete: SetNull)
  title          String
  /// Why it fits, written by the AI and checked against the CV evidence catalog.
  reason         String?
  /// False when the reason cites evidence ids that don't exist or numbers the evidence doesn't contain.
  reasonVerified Boolean     @default(true)
  evidenceIds    String[]
  titleVariants  String[]
  keywords       String[]
  /// Openings found, average fit and most common missing skill, filled after each search (Phase 3d).
  marketStats    Json?
  /// ai | user | no_ai
  source         String
  /// Used for job search.
  selected       Boolean     @default(false)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, selected])
  @@map("target_roles")
}

/// An employer, one row per user and normalised name (SPEC §4). Staffing agencies and companies the user blocks
/// are kept so their postings can be hidden.
model Company {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  /// Lower case, legal suffixes removed ("Kestrel Pay Pvt. Ltd." → "kestrel pay").
  normalizedName   String
  aliases          String[]
  website          String?
  careersUrl       String?
  isStaffingAgency Boolean      @default(false)
  isBlocked        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  jobs             Job[]
  careerSites      CareerSite[]

  @@unique([userId, normalizedName])
  @@map("companies")
}

/// A job posting found by search (or added by hand later). It may exist without an application (SPEC §4).
/// The HNSW index on `embedding` is created in SQL (Prisma can't describe it): when a new migration is generated,
/// delete any "DROP INDEX jobs_embedding_hnsw" line it adds.
model Job {
  id                      String                      @id @default(cuid())
  userId                  String
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId               String?
  company                 Company?                    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// Company as the posting wrote it (shown to the user).
  companyName             String
  title                   String
  roleFamilyId            String?
  /// Target roles whose searches found this job (for per-role market stats).
  targetRoleIds           String[]
  seniority               String?
  location                String?
  /// Canonical city: Bengaluru, Gurugram, Mumbai, Remote-India, …
  locationCity            String?
  /// remote | hybrid | onsite
  workMode                String?
  employmentType          String?
  salaryMinAnnual         Int?
  salaryMaxAnnual         Int?
  salaryCurrency          String?
  salaryText              String?
  salaryDisclosed         Boolean                     @default(false)
  expMinYears             Float?
  expMaxYears             Float?
  descriptionRaw          String
  descriptionHash         String
  descriptionTruncated    Boolean                     @default(false)
  /// search | deep_search | paste | url | manual | csv
  origin                  String
  /// adzuna | jooble | serpapi | greenhouse | lever | … | mock
  provider                String
  externalId              String
  postedVia               String?
  isDirectFromCompany     Boolean                     @default(false)
  /// [{ site, url }], merged when duplicates are found
  applyLinks              Json
  postedAt                DateTime?
  discoveredAt            DateTime                    @default(now())
  /// new | saved | dismissed
  feedStatus              String                      @default("new")
  dismissReason           String?
  /// Relevance (SPEC §10.5), 0–100, and its parts with reasons.
  quickScore              Int?
  scoreParts              Json?
  /// Fit score of the latest analysis (SPEC §12.2) and its recommendation; null until analysed.
  fitScore                Int?
  fitRecommendation       String?
  /// What the feed sorts by: the Fit score when there is one, else relevance (SPEC §10.6).
  sortScore               Int?
  searchRunId             String?
  /// { noticePeriodMaxDays, immediateJoiner, bond, shift, contractToHire, wfoDaysPerWeek } found by regex
  conditions              Json?
  isStale                 Boolean                     @default(false)
  /// Why the job is hidden as "Not a fit" (seniority, location, dealbreakers); empty when it fits.
  notFitReasons           String[]
  embedding               Unsupported("vector(384)")?
  embeddingModel          String?
  embeddedAt              DateTime?
  /// From JobExtractor (SPEC §12.5): what the job involves, in the posting's words.
  responsibilities        String[]
  /// Other extracted fields: { domain, employmentType, seniority, experience, roleFamilySlug, droppedRequirements }
  extraction              Json?
  extractedAt             DateTime?
  /// ai | cache | no_ai, with the provider/model and prompt version that produced the extraction.
  extractionMode          String?
  extractionModel         String?
  extractionPromptVersion String?
  /// The description hash the extraction was made from; a changed description is extracted again.
  extractionSourceHash    String?
  injectionSuspected      Boolean                     @default(false)
  requirements            JobRequirement[]
  analyses                JobAnalysis[]
  application             Application?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  @@unique([userId, provider, externalId])
  @@index([userId, feedStatus, quickScore])
  @@index([userId, feedStatus, sortScore])
  @@index([userId, descriptionHash])
  @@index([userId, companyId])
  @@map("jobs")
}

/// A resumable job search (SPEC §10.4, §11.5): the browser advances it in short steps; closing the tab pauses it.
model JobSearchRun {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// standard | deep (Phase 5)
  kind               String    @default("standard")
  targetRoleIds      String[]
  /// { queries: [{ query, location, priority, roleIds }] }
  plan               Json
  /// Where the run is: { stage, queryIndex, … }
  state              Json
  requestsByProvider Json      @default("{}")
  pagesFetched       Int       @default(0)
  resultCount        Int       @default(0)
  newCount           Int       @default(0)
  duplicateCount     Int       @default(0)
  /// [{ at, message }]
  errors             Json      @default("[]")
  /// running | done | failed
  status             String    @default("running")
  finishedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, createdAt])
  @@map("job_search_runs")
}

/// One requirement of a job (SPEC §12), cited in Fit Reports by its id R1…Rn.
model JobRequirement {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// R1…Rn within the job.
  reqId         String
  skillId       String?
  skill         Skill?  @relation(fields: [skillId], references: [id], onDelete: SetNull)
  text          String
  /// skill | experience | education | domain | responsibility | soft | other
  kind          String
  /// required | preferred | nice_to_have | implied
  importance    String
  yearsRequired Float?
  /// The words in the posting this requirement comes from (checked against the description).
  quote         String
  /// ai | user | keyword
  source        String
  sortOrder     Int

  @@unique([jobId, reqId])
  @@index([userId, jobId])
  @@index([skillId])
  @@map("job_requirements")
}

/// The user's Fit-score settings (SPEC §12.2). Each save adds a version; analyses record the version they used.
model ScoringConfig {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    Int
  /// { skills, experience, roleAlignment, location, salary } — component maxima, summing to 100
  weights    Json
  /// { apply, consider }
  thresholds Json
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([userId, version])
  @@index([userId, active])
  @@map("scoring_configs")
}

/// A Fit analysis of one job (SPEC §12): the score and its parts computed in code; the report text comes from
/// FitAnalyst. Cached by the hash of every input, so an unchanged job and profile is never analysed twice.
model JobAnalysis {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId                String
  job                  Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeVersionId      String?
  resumeVersion        ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  /// 0 = the built-in defaults.
  scoringConfigVersion Int
  scoreTotal           Int
  /// Components, requirement statuses and condition checks.
  breakdown            Json
  /// APPLY | CONSIDER | LOW_PRIORITY
  recommendation       String
  blockers             Json
  gains                Json
  salaryContext        Json?
  /// FitAnalyst output (SPEC §12.4), added in step 4b.
  report               Json?
  validation           Json?
  model                String?
  promptVersion        String?
  inputHash            String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([userId, jobId, inputHash])
  @@index([userId, jobId, createdAt])
  @@map("job_analyses")
}

/// A company career site CareerOS knows about (SPEC §11.2): an ATS job board or a careers page. The registry grows
/// with every discovery, so later runs mostly re-check known sites through keyless APIs.
model CareerSite {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// Company or board name as shown.
  name             String
  /// Stable identity: "greenhouse:kestrelpay", "html:careers.example.com/jobs", or "name:kestrel pay" while unresolved.
  key              String
  /// greenhouse | lever | ashby | smartrecruiters | recruitee | jsonld | html | unknown (a watchlist name not found yet)
  kind             String
  boardToken       String?
  url              String?
  /// discovered | user
  source           String
  /// active | unresolved | no_relevant_jobs | blocked_by_robots | failed
  status           String    @default("active")
  /// The web search that found it, for transparency.
  discoveredFrom   String?
  lastFetchedAt    DateTime?
  nextCheckAt      DateTime?
  lastJobCount     Int       @default(0)
  relevantJobCount Int       @default(0)
  /// Runs in a row without a relevant job (after 3, the site is checked weekly).
  emptyRuns        Int       @default(0)
  failures         Int       @default(0)
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, key])
  @@index([userId, status, nextCheckAt])
  @@map("career_sites")
}

/// An application the user made (SPEC §13). Created by "Mark as applied"; the job and its Fit Report are frozen in
/// jobSnapshot, so the record keeps what the user applied to even if the posting changes or disappears.
model Application {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// One application per job. Kept (job set to null) if the job is ever deleted.
  jobId           String?            @unique
  job             Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// APPLIED | RECRUITER_CONTACT | ASSESSMENT | INTERVIEW | FINAL_ROUND | OFFER | REJECTED | WITHDRAWN | GHOSTED
  status          String
  /// Highest stage ever recorded (APPLIED 1 … OFFER 6); funnel metrics use it, never the current status (SPEC §5).
  stageReached    Int
  appliedAt       DateTime
  /// Set when the application ends (rejected, withdrawn, ghosted); cleared if it is reopened.
  closedAt        DateTime?
  resumeVersionId String?
  resumeVersion   ResumeVersion?     @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  /// company_site | linkedin | naukri | indeed | other_job_site | recruiter | email | other
  source          String
  isReferral      Boolean            @default(false)
  referrerName    String?
  /// outbound (the user applied) | inbound (a recruiter reached out first; excluded from outbound rates)
  direction       String             @default("outbound")
  followUpAt      DateTime?
  /// pending | accepted | declined, once there is an offer
  offerDecision   String?
  rejectionReason String?
  /// The stage the application had reached when it was rejected (APPLIED … OFFER).
  rejectedAtStage String?
  /// The job and its Fit Report when the user applied: { version, job, requirements, fit }
  jobSnapshot     Json
  lastActivityAt  DateTime
  notes           String?
  events          ApplicationEvent[]
  rounds          InterviewRound[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId, status])
  @@index([userId, appliedAt])
  @@map("applications")
}

/// The application's timeline (SPEC §13): every status change, round and note, oldest first.
model ApplicationEvent {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// applied | status_change | round_added | note
  type          String
  fromStatus    String?
  toStatus      String?
  /// When it happened (the user may log something that happened earlier), not when it was recorded.
  occurredAt    DateTime
  title         String
  note          String?
  /// user | system
  createdBy     String      @default("user")
  /// The application's fields before a status change, so the change can be undone exactly.
  previous      Json?
  createdAt     DateTime    @default(now())

  @@index([applicationId, occurredAt])
  @@map("application_events")
}

/// One interview round (SPEC §18): logged in Phase 6, used by interview prep and analytics later.
model InterviewRound {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// recruiter_screen | technical | coding | system_design | take_home | hiring_manager | behavioural | hr | final | other
  roundType      String
  scheduledAt    DateTime?
  /// pending | passed | failed | cancelled
  result         String      @default("pending")
  /// 1–5, how the user felt it went
  selfRating     Int?
  topicSkillIds  String[]
  questionsAsked String[]
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([applicationId, scheduledAt])
  @@map("interview_rounds")
}
